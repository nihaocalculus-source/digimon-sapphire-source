Digimon_Text_Reunion::
    .string "TAI: All four seals are broken!\p"
    .string "MATT: But the DARK MASTERS' data\n"
    .string "is rebuilding inside the glitch!\p"
    .string "The eight crests shine together.\n"
    .string "Every partner lends their strength.\p"
    .string "TAI: One final battle, together!$"
Digimon_Text_Courage::
    .string "TAI: AGUMON! Let our courage\n"
    .string "carry you to WARGREYMON!$"
Digimon_Text_Friendship::
    .string "MATT: GABUMON! Our friendship\n"
    .string "shines as METALGARURUMON!$"
Digimon_Text_DNA::
    .string "TAI and MATT: Together!\p"
    .string "WARGREYMON! METALGARURUMON!\n"
    .string "DNA-DIGIVOLVE!$"
Digimon_Text_Omegamon::
    .string "OMEGAMON!\p"
    .string "Two partners. One shared hope.\n"
    .string "Face the DARK MASTERS one last time!$"
Digimon_Text_GateHome::
    .string "The multiverse glitch is repaired.\n"
    .string "A familiar skyline appears.\p"
    .string "TAI: That's our world!\n"
    .string "MATT: Everyone is waiting. Let's go.\p"
    .string "Your partners separate safely as\n"
    .string "you step through the gate together.$"
Digimon_Text_GateLocked::
    .string "The gate is sealed.\p"
    .string "Gather all eight DIGITAL KEYS and\n"
    .string "defeat all four DARK MASTERS.$"

Digimon_Text_DarkCoreDefeat::
    .string "Our broken worlds... restored...\n"
    .string "The DARK MASTERS dissolve into light!$"
