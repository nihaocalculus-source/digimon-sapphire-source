Route101_Text_16D10E:: @ 816D10E
	.string "The glitch is spreading! Help!$"

Route101_Text_16D119:: @ 816D119
	.string "BIRCH: Your partner's signal is\n"
	.string "in my BAG! Reconnect before the\p"
	.string "wild data attacks!$"

Route101_Text_16D15E:: @ 816D15E
	.string "Wh-Where are you going?!\n"
	.string "Don't leave me like this!$"

Route101_Text_16D191:: @ 816D191
	.string "BIRCH: You did it! Your\n"
	.string "partner's bond cuts through the\p"
	.string "corruption.\p"
	.string "Come to my LAB. We must talk\n"
	.string "about the DIGITAL KEYS and the\p"
	.string "gate home.$"

Route101_Text_16D25E:: @ 816D25E
	.string "If DIGIMON get tired, take them to\n"
	.string "a DIGIMON CENTER.\p"
	.string "There's a DIGIMON CENTER in OLDALE\n"
	.string "TOWN right close by.$"

Route101_Text_16D2CB:: @ 816D2CB
	.string "Wild DIGIMON will jump out at you in\n"
	.string "tall grass.\p"
	.string "If you want to catch DIGIMON, you have\n"
	.string "to go into the tall grass and search.$"

Route101_Text_16D349:: @ 816D349
	.string "ROUTE 101\n"
	.string "{0x79} OLDALE TOWN$"
